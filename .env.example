# ================================
# Qwen3-ASR Dual-4090 Service Env
# ================================

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 对外鉴权密钥（多个 Key 用英文逗号分隔；留空则关闭鉴权，生产环境务必配置！）
API_KEYS=sk-asr-change-me-in-production

# 模型路径（生产环境强烈建议先用 scripts/download_models.py 下载到本地）
ASR_MODEL_PATH=/models/Qwen3-ASR-1.7B
ALIGNER_MODEL_PATH=/models/Qwen3-ForcedAligner-0.6B
SERVED_MODEL_NAME=qwen3-asr-1.7b

# 推理引擎与双卡 4090 配置
# ASR_BACKEND 可选: vllm（推荐）| transformers | mock（本地无卡调试）
ASR_BACKEND=vllm
# 每个 GPU 启动 1 个独立 Worker 进程（双 4090 = 0,1，数据并行 2x 吞吐）
GPU_IDS=0,1
# 每张 4090 (24GB) 或 4080 SUPER (32GB) 分配显存比例给 vLLM，余量留给 ForcedAligner-0.6B 和运行时缓存
# 推荐：32GB 卡设 0.58 + MAX_INFERENCE_BATCH_SIZE=24 + ALIGNER_BATCH_SIZE=6；24GB 卡设 0.62 + 16 + 6
GPU_MEMORY_UTILIZATION=0.58
MAX_INFERENCE_BATCH_SIZE=24
# ForcedAligner 单次前向子批大小（与 vLLM 批大小解耦，防长切片并发 OOM）
ALIGNER_BATCH_SIZE=6
MAX_NEW_TOKENS=2048
# 公平轮转调度单次从单个任务派发的切片粒度（Worker 会跨并发任务自动合并至 MAX_INFERENCE_BATCH_SIZE）
CHUNKS_PER_DISPATCH=6
# Worker 跨任务合批最大等待窗口（毫秒，仅单卡或批未满时生效）
BATCH_COALESCE_WAIT_MS=15
# 若镜像内已编译安装 flash-attn，可设为 true 进一步加速 ForcedAligner
USE_FLASH_ATTENTION=false
WORKER_STARTUP_TIMEOUT_SEC=300
# 可选：冷启动与 CUDA Graph 调优（Serverless / Modal 快照场景推荐开启）
# VLLM_MAX_MODEL_LEN=16384
# VLLM_ENFORCE_EAGER=false
# VLLM_CUDAGRAPH_MODE=FULL_DECODE_ONLY
# VLLM_CUDAGRAPH_CAPTURE_SIZES=1,2,4,8,16
# WARMUP_ON_STARTUP=true

# 长录音切片与上传限制
# 切分策略: vad（Silero VAD 引导无损切分，含响度自适应 + 多线程并行，推荐）| energy（纯低能量谷底）
CHUNK_STRATEGY=vad
# 目标切片时长（秒），必须 < 180s 以满足 Qwen3-ForcedAligner 上限
CHUNK_TARGET_SEC=120
# 在目标切分点前后搜索停顿/静音的半窗（秒），±15s 即 30s 窗口
CHUNK_SEARCH_EXPAND_SEC=15
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=150
# Silero VAD 并行 CPU 线程数（线程本地 ONNX 会话，零锁竞争）
VAD_MAX_WORKERS=6
# 最大并发 ffmpeg 转码进程数（防止高并发上传打满 CPU）
MAX_CONCURRENT_DECODES=4
# 单文件上传大小上限（MB）
MAX_UPLOAD_SIZE_MB=500
# 同步接口建议最大时长（秒），超长录音建议走 /v1/asr/tasks 异步任务接口
MAX_SYNC_AUDIO_SEC=600
MAX_CONCURRENT_JOBS=16

# 数据目录（SQLite 任务持久化 + 临时音频转码目录）
DATA_DIR=./data
# 可选：临时 WAV 存放目录覆盖（如 Linux 内存充足时可设为 /dev/shm/qwen3_asr_tmp 实现纯内存级 I/O）
TEMP_DIR=
TASK_RETENTION_HOURS=72
WEBHOOK_TIMEOUT_SEC=15
